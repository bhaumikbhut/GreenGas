PROTRACK_BASE_URL=https://api.protrack365.com
PROTRACK_ACCOUNT_LPG=GGLPG
PROTRACK_PASSWORD_LPG=
PROTRACK_ACCOUNT_PROPANE=GG11
PROTRACK_PASSWORD_PROPANE=
GEOFENCE_RADIUS_M=500
POLL_HINT_SECONDS=30
# portal = website login bridge (works now). openapi = official API (needs vendor enable)
GPS_SOURCE=portal
PROTRACK_PORTAL_URL=https://www.protrack365.com
PROTRACK_GPSDATA_URL=https://real.gpscenter.xyz

# WhatsApp Business Cloud API (Meta)
# Comma-separated recipients, country code, no + (e.g. 9198XXXXXXXX)
WHATSAPP_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved template: body vars plate, status, location, time
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Public URL used in WhatsApp "Live track" links (Vercel production domain)
APP_PUBLIC_URL=https://green-gas-sigma.vercel.app

# Persistent status store (Upstash Redis / Vercel KV) — set automatically when KV is linked
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Fleet snapshot cache (cron fills Redis; /api/trucks reads it)
# Fresh under this many seconds; older still served, then background refresh
FLEET_CACHE_FRESH_SEC=45
# Protect /api/cron/refresh-fleet (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=
